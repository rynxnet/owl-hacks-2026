# Copy to presage-bridge/.env
# Presage API key: https://physiology.presagetech.com (log in, copy key)
PRESAGE_API_KEY=

# Where the backend is.
#   Backend on this laptop:        ws://localhost:3001/ws/vitals
#   Backend in a GitHub Codespace: wss://<codespace-name>-3001.app.github.dev/ws/vitals
#                                  (Ports tab -> port 3001 -> Port Visibility -> Public)
VITALS_URL=ws://localhost:3001/ws/vitals

# 0 = default webcam. Try 1, 2... if it opens the wrong camera.
CAMERA_INDEX=0

# Ignore pulse readings below this confidence (0-1). 0 = accept all.
MIN_CONFIDENCE=0
