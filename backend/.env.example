# Copy to backend/.env and fill in. GEMINI_API_KEY is required (it runs the interviewer); the rest are optional.
PORT=3001

# Gemini: https://aistudio.google.com/apikey  (required: every interviewer line is generated by Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional, for busy moments: tried in order when the main model is overloaded (503) or out of quota (429).
# npm run check:gemini tests every key/model and suggests fallback models.
# GEMINI_FALLBACK_MODELS=
# GEMINI_BACKUP_KEYS=        # keys from a different Google project have their own quota
# Optional tuning for the interviewer agent:
# GEMINI_TURN_TIMEOUT_MS=18000          # one reply, including one rewrite if the first draft is generic
# GEMINI_BRIEFING_TIMEOUT_MS=20000      # building the interviewer persona from the job posting
# GEMINI_BRIEFING_THINKING_LEVEL=LOW
# GEMINI_RAPID_THINKING_LEVEL=LOW   # MINIMAL is faster but some Flash models reject it (the app then falls back)

# ElevenLabs: https://elevenlabs.io (Developers -> API keys; give it Text to Speech + Voices read access).
# Voice IDs are optional: defaults are premade voices. Run `npm run voices` to list yours and test.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_flash_v2_5
VOICE_FRIENDLY=
VOICE_COLD=
VOICE_RAPID=

# Stress logic tuning (milliseconds / fractions)
BASELINE_MS=12000
WINDOW_MS=10000
ELEVATED_PCT=0.15
OVERLOAD_PCT=0.30
HOLD_MS=6000

# Presage (heart rate from the webcam): https://physiology.presagetech.com
# PRESAGE_MODE=bridge (default, the setup that works): run presage-bridge on the laptop with the webcam
#   (cd presage-bridge && npm start). The backend never touches the camera. The bridge reads
#   PRESAGE_API_KEY from presage-bridge/.env, or from this file if that one is empty.
# PRESAGE_MODE=server: the browser streams its camera to this backend and Presage runs here instead.
#   Then do NOT run the bridge too (they fight over the camera). Test: npm run check:presage
PRESAGE_MODE=bridge
PRESAGE_API_KEY=
# Ignore pulse readings below this confidence (0-1). 0 = accept all.
PRESAGE_MIN_CONFIDENCE=0

# Stress baseline (see src/stress.js): readings needed before it locks, max gap between
# "regular" readings, and how many regular readings in a row before the baseline clock starts
BASELINE_MIN_SAMPLES=5
BASELINE_MAX_GAP_MS=5000
BASELINE_STEADY_N=2

# Heart-rate cleanup before the stress engine (see src/vitalsFilter.js)
# Plausible range; readings outside it are dropped
FILTER_MIN_BPM=35
FILTER_MAX_BPM=220
# 1 = also drop readings the source flags as stable:false
FILTER_REQUIRE_STABLE=0
# A reading more than FILTER_JUMP_BPM from the recent median is held back unless
# FILTER_JUMP_CONFIRM readings in a row agree on the new level. "Recent" = the last
# FILTER_HISTORY_N accepted readings within FILTER_JUMP_WINDOW_MS.
FILTER_JUMP_BPM=25
FILTER_JUMP_CONFIRM=3
FILTER_JUMP_WINDOW_MS=5000
FILTER_HISTORY_N=5
# Median of this many readings feeds the stress engine (1 = no smoothing)
FILTER_SMOOTH_N=3
# No accepted reading for this long shows "Lost your pulse reading" in the app
FILTER_STALE_MS=5000
# 1 = log every dropped reading and why
FILTER_DEBUG=0

# Simulator (npm run sim): 0 turns off fake glitches and dropouts
SIM_GLITCHES=1
