# Copy to backend/.env and fill in. Every key is optional: the app runs without them.
PORT=3001

# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ElevenLabs: https://elevenlabs.io (Developers -> API keys; give it Text to Speech + Voices read access).
# Voice IDs are optional: defaults are premade voices. Run `npm run voices` to list yours and test.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_flash_v2_5
VOICE_FRIENDLY=
VOICE_COLD=
VOICE_RAPID=

# Tiger Data connection string (Postgres URL from the Tiger Cloud console)
DATABASE_URL=

# Stress logic tuning (milliseconds / fractions)
BASELINE_MS=30000
WINDOW_MS=10000
ELEVATED_PCT=0.15
OVERLOAD_PCT=0.30
HOLD_MS=6000

# Presage (heart rate from the webcam): https://physiology.presagetech.com
# With a key, the browser streams its camera to this server and Presage runs here. Test: npm run check:presage
PRESAGE_API_KEY=
# Ignore pulse readings below this confidence (0-1). 0 = accept all.
PRESAGE_MIN_CONFIDENCE=0
